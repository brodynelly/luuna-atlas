# Luuna Atlas optional diagnostics (legacy environment names retained).
# No provider credentials are required. Do not commit a real .env file.
# LUUNA_ATLAS_DEBUG=1
# LUUNA_ATLAS_LOG_LEVEL=debug
# LUUNA_ATLAS_LOG_JSON=1
# LUUNA_ATLAS_HOOK and LUUNA_ATLAS_RECIPE_* are set by Atlas for child hooks/recipes.
